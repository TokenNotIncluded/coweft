# Copy to .env; never commit real credentials. Put HTTPS reverse proxy in front.
COWEFT_ORIGIN=https://community.example.org
COWEFT_DEV=false
LISTEN_ADDR=0.0.0.0:8080
# Generate with: openssl rand -base64 32
SESSION_KEY=
# Use a URL-safe random password (openssl rand -hex 24), since compose embeds it in a URI.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://coweft:replace@127.0.0.1:5432/coweft
# Only api.lmm.best is trusted in production. This is LMM's subproject OIDC issuer.
LMM_ISSUER=https://api.lmm.best/oidc
LMM_CLIENT_ID=coweft-web
LMM_RESOURCE_ID=coweft
LMM_RESOURCE_SECRET=
# Optional public AI worker; NEVER reuse the OAuth resource introspection secret.
LMM_MODEL_API_KEY=
LMM_MODEL=
AI_DAILY_REQUESTS=100
RUST_LOG=info
