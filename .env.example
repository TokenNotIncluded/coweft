# Copy to .env; never commit credentials. Put an HTTPS reverse proxy in front.
COWEFT_ORIGIN=https://community.example.org
COWEFT_DEV=false
LISTEN_ADDR=0.0.0.0:8080
# Generate independently: openssl rand -base64 32
SESSION_KEY=
# Use a URL-safe password: openssl rand -hex 24
POSTGRES_PASSWORD=
DATABASE_URL=postgres://coweft:replace@127.0.0.1:5432/coweft
LMM_ISSUER=https://api.lmm.best/oidc
LMM_CLIENT_ID=coweft-web
LMM_RESOURCE_ID=coweft
LMM_RESOURCE_SECRET=
# Optional public AI worker: separate from all OAuth credentials.
LMM_MODEL_API_KEY=
LMM_MODEL=
AI_DAILY_REQUESTS=100
# Explicit public-thread snapshot replication, not global governance.
COWEFT_FEDERATION_ENABLED=false
COWEFT_FEDERATION_PEERS=
RUST_LOG=info
